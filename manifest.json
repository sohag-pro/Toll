{
  "manifest_version": 3,
  "name": "Toll: pay math to keep scrolling",
  "version": "0.2.7",
  "description": "Every reel costs you. Toll makes it literal. Solve a math problem to advance the next Short or Reel, or to load more of your homepage feed. YouTube, Facebook, Instagram, TikTok.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/core.js", "src/platforms/youtube.js"],
      "css": ["src/style.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["src/core.js", "src/platforms/facebook.js"],
      "css": ["src/style.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/core.js", "src/platforms/instagram.js"],
      "css": ["src/style.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["src/core.js", "src/platforms/tiktok.js"],
      "css": ["src/style.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Toll",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}
